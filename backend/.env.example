# Copy this file to .env for local development and add your real key there.
# Never commit .env or put AI_API_KEY in frontend code.
AI_API_KEY=

# Optional; defaults to the OpenAI-compatible Chat Completions endpoint.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Comma-separated exact browser origins. Include only your deployed site origin.
# GitHub Pages default origin: https://elammaouimustapha987-dotcom.github.io
ALLOWED_ORIGINS=https://elammaouimustapha987-dotcom.github.io

# The hosting platform supplies PORT in deployment.
PORT=3000
